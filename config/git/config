[init]
	defaultBranch = main
[core]
	editor = nvim
[diff]
	tool = nvimdiff
[difftool]
	prompt = false
[merge]
	tool = nvimdiff
[alias]
    cb = "!git rev-parse --abbrev-ref HEAD"
[commit]
    template = ~/.config/git/template

[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
[include]
	path = ~/.config/git/private
[include]
	path = ~/.config/git-work/config
[includeIf "hasconfig:remote.*.url:https://github.com/noganogami/**"]
	path = ~/.config/git/private
[includeIf "hasconfig:remote.*.url:https://*@github.com/noganogami/**"]
	path = ~/.config/git/private
